# Template: scripts/usage-guard/install.sh fills in python3, PATH and the Cockpit CLI for this machine.
[Unit]
Description=AI Office usage-guard: waits out provider usage limits and resumes stopped Cockpit work
After=default.target

[Service]
Type=simple
Environment=PATH=@PATH@
Environment=AIO_GUARD_COCKPIT=@COCKPIT@
ExecStart=@PYTHON@ %h/.local/share/aio-usage-guard/usage-guard.py daemon
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
