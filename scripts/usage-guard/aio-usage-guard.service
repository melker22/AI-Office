# Template: scripts/usage-guard/install.sh fills in the python3 path and PATH for this machine.
[Unit]
Description=AI Office usage-guard: waits out provider usage limits and resumes stopped Cockpit work
After=default.target

[Service]
Type=simple
Environment=PATH=@PATH@
ExecStart=@PYTHON@ %h/.local/share/aio-usage-guard/usage-guard.py daemon
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
