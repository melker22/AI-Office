#!/usr/bin/env bash
# Wrapper so `aioffice` works without a global NixOS PATH entry.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="${AIOFFICE_BIN:-$ROOT/build/linux/aioffice}"
if [[ ! -x "$BIN" ]]; then
  echo "aioffice binary not found at $BIN" >&2
  echo "Build with: nix-shell && cmake --preset linux && cmake --build --preset linux" >&2
  exit 1
fi
exec "$BIN" "$@"
