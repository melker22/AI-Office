[
  {"tool": "document_new", "args": {"title": "RTF link format", "force": true}},
  {"tool": "replace_range", "args": {"id": "p1", "blocks": [
    {"type": "paragraph", "runs": [
      {"text": "Site", "bold": true, "color": "#C0392B", "link": "https://example.com/a"},
      {"text": " "},
      {"text": "1", "bold": true, "color": "#1A5276", "field": "page_number"}
    ]}
  ]}},
  {"tool": "document_save", "args": {"path": "/tmp/wave20-rtf-hyperlink.rtf"}, "expect": {"ok": true}}
]
