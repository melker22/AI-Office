[
  {"tool": "document_new", "args": {"title": "Wave3", "force": true}},
  {"tool": "set_page_layout", "args": {"border_pt": 0.75, "border_color": "#B5651D"}},
  {"tool": "insert_at_caret", "args": {"id": "p1", "offset": 0, "text": "Aveiro\tcidade\nOlá {{nome}}"}},
  {"tool": "apply_paragraph_format", "args": {
    "id": "p1",
    "drop_cap_lines": 3,
    "border_pt": 0.5,
    "border_color": "#B5651D",
    "tabs": [{"pos_mm": 30, "align": "left"}, {"pos_mm": 90, "align": "right"}]
  }},
  {"tool": "insert_table", "args": {"after_id": "p1", "rows": 2, "cols": 2, "header": true, "header_texts": ["A", "B"]}},
  {"tool": "nest_table", "args": {"id": "t1", "row": 1, "col": 0, "rows": 2, "cols": 2}},
  {"tool": "set_cell", "args": {"id": "t1", "row": 1, "col": 0, "nested_row": 0, "nested_col": 0, "text": "in"}},
  {"tool": "page_preview", "args": {"from": 1, "to": 1, "zoom": 1}},
  {"tool": "mail_merge", "args": {"records": [{"nome": "Ana"}, {"nome": "Bia"}]}},
  {"tool": "page_preview", "args": {"from": 1, "to": 2, "zoom": 1}},
  {"tool": "validate", "args": {}},
  {"tool": "document_export_pdf", "args": {"path": "/tmp/aio-wave3.pdf", "pdfa": true}}
]
