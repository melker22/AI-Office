[
  {"tool": "document_new", "args": {"title": "Hide if page reject", "force": true}},
  {"tool": "insert_at_caret", "args": {"id": "p1", "offset": 0, "text": "A"}},
  {"tool": "apply_paragraph_format", "args": {"id": "p1", "hide_if": "page > 1"}, "expect": {
    "ok": false,
    "error": "hide_if cannot depend on page or pages (evaluated once, before pagination)"
  }},
  {"tool": "apply_paragraph_format", "args": {"id": "p1", "hide_if": "pages > 1"}, "expect": {
    "ok": false,
    "error": "hide_if cannot depend on page or pages (evaluated once, before pagination)"
  }},

  {"tool": "document_open", "args": {"path": "qa/wave22-hide-if-page-bad.aio.json"}, "expect": {"ok": true}},
  {"tool": "validate", "args": {}, "expect": {
    "valid": false,
    "errors.0.code": "invalid_expression",
    "errors.0.id": "p2",
    "errors.0.message": "hide_if cannot depend on page or pages (evaluated once, before pagination)"
  }},

  {"tool": "document_new", "args": {"title": "Hide if once", "force": true}},
  {"tool": "insert_at_caret", "args": {"id": "p1", "offset": 0, "text": "Visivel um dois"}},
  {"tool": "insert_blocks", "args": {"after_id": "p1", "blocks": [
    {"id": "pHide", "type": "paragraph", "runs": [{"text": "Oculto tres quatro"}]},
    {"id": "tHide", "type": "table", "rows": [[{"runs": [{"text": "cinco"}]}]]},
    {"type": "image", "id": "iHide", "image_b64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==", "width_mm": 8, "alt": "fig"}
  ]}},
  {"tool": "apply_paragraph_format", "args": {"id": "pHide", "hide_if": "flag == \"on\""}},
  {"tool": "apply_paragraph_format", "args": {"id": "tHide", "hide_if": "flag == \"on\""}},
  {"tool": "apply_paragraph_format", "args": {"id": "iHide", "hide_if": "flag == \"on\""}},
  {"tool": "set_vars", "args": {"name": "flag", "value": "on"}},
  {"tool": "page_preview", "args": {"page": 1}, "expect": {"ids": ["p1"]}},
  {"tool": "document_stats", "args": {}, "expect": {"paragraphs": 1, "tables": 0, "images": 0, "words": 3, "chars": 15}},
  {"tool": "insert_field", "args": {"id": "p1", "offset": 15, "kind": "stat", "arg": "paragraphs"}},
  {"tool": "document_get", "args": {}, "expect": {
    "document.body.0.runs.1.field": "stat",
    "document.body.0.runs.1.text": "1"
  }},
  {"tool": "document_save", "args": {"path": "/tmp/wave22-hide-if-once.pdf"}},
  {"tool": "document_save", "args": {"path": "/tmp/wave22-hide-if-once.docx", "embed_json": true}},
  {"tool": "document_open", "args": {"path": "/tmp/wave22-hide-if-once.docx"}},
  {"tool": "set_vars", "args": {"name": "flag", "value": "on"}},
  {"tool": "page_preview", "args": {"page": 1}, "expect": {"ids": ["p1"]}},
  {"tool": "document_stats", "args": {}, "expect": {"paragraphs": 1, "tables": 0, "images": 0, "words": 3}}
]
