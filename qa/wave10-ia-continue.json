  {"tool": "document_a11y", "args": {}},
  {"tool": "document_links", "args": {}},
  {"tool": "figure_index", "args": {"after_id": "end"}},
  {"tool": "align_objects", "args": {"align": "center"}},
  {"tool": "snapshot_save", "args": {"name": "w10"}},
  {"tool": "snapshot_list", "args": {}},
  {"tool": "insert_shape", "args": {"after_id": "end", "shape": "line", "width_mm": 40, "height_mm": 8}},
