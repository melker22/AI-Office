  {"tool": "insert_blocks", "args": {"after_id": "end", "blocks": [
    {"type": "image", "width_mm": 40, "alt": "", "caption": "Figura um"}
  ]}},
  {"tool": "set_image", "args": {"id": "img1", "flip_h": true, "shadow_pt": 3, "crop": [0.05, 0.05, 0.05, 0.05], "alt": "foto"}},
  {"tool": "bibliography_set", "args": {"id": "smith", "key": "smith", "author": "Smith", "year": "2020", "title": "Paper"}},
  {"tool": "insert_citation", "args": {"key": "smith", "id": "p2"}},
  {"tool": "autotext_set", "args": {"name": "sig", "text": " Equipa"}},
  {"tool": "set_selection", "args": {"anchor_id": "p2", "focus_id": "p2", "anchor_off": 0, "focus_off": 0}},
  {"tool": "autotext_insert", "args": {"name": "sig", "id": "p2", "offset": 0}},
  {"tool": "comment_add", "args": {"id": "p2", "text": "pai"}},
  {"tool": "redact", "args": {"id": "p1"}},
  {"tool": "set_user_dic", "args": {"word": "AIOFFICE"}},
  {"tool": "thesaurus_set", "args": {"word": "teste", "synonyms": "prova"}},
  {"tool": "thesaurus_get", "args": {"word": "teste"}},
