[
  {"tool": "document_new", "args": {"title": "Wave10", "force": true}},
  {"tool": "set_page_layout", "args": {
    "width_mm": 148, "height_mm": 210, "tone": "sepia",
    "line_numbers": true, "chapter_numbers": true, "grid_mm": 8,
    "hyphenate": true, "hyphen_zone_mm": 6, "gutter_mirror": true
  }},
  {"tool": "insert_blocks", "args": {"after_id": "p1", "blocks": [
    {"type": "heading", "level": 1, "style": "Heading 1", "runs": [{"text": "Capitulo"}]},
    {"type": "paragraph", "runs": [{"text": "the the  texto com ruby"}]}
  ]}},
  {"tool": "apply_character_format", "args": {"id": "p2", "ruby": "ル"}},
  {"tool": "insert_shape", "args": {"after_id": "end", "shape": "rect", "fill": "#F3E0CC", "width_mm": 40, "height_mm": 20}},
  {"tool": "insert_shape", "args": {"after_id": "end", "shape": "ellipse", "width_mm": 30, "height_mm": 20, "connect_to": "sh1"}},
  {"tool": "insert_chart", "args": {"after_id": "end", "data": [{"label": "A", "value": 3}, {"label": "B", "value": 7}]}},
  {"tool": "insert_qr", "args": {"after_id": "end", "qr": "AIOFFICE"}},
  {"tool": "insert_equation", "args": {"after_id": "end", "text": "E=mc^2", "numbered": true}},
