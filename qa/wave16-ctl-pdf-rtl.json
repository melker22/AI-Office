[
  {
    "tool": "document_new",
    "args": {
      "title": "Wave16 RTL PDF",
      "force": true
    }
  },
  {
    "tool": "insert_blocks",
    "args": {
      "after_id": "start",
      "blocks": [
        {
          "type": "paragraph",
          "dir": "rtl",
          "align": "start",
          "runs": [
            {
              "text": "مرحبا بالعالم"
            }
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "LTR paragraph after RTL."
            }
          ]
        }
      ]
    }
  },
  {
    "tool": "document_export_pdf",
    "args": {
      "path": "/tmp/wave16-rtl.pdf"
    }
  },
  {
    "tool": "validate",
    "args": {},
    "expect": {
      "valid": true
    }
  }
]
