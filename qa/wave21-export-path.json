  {"tool": "document_save", "args": {"path": "/tmp/wave21-export.md"}, "expect": {"ok": true, "path": "/tmp/wave21-export.aio.json", "dirty": false}},
  {"tool": "document_save", "args": {"path": "/tmp/wave21-export.txt"}, "expect": {"ok": true, "path": "/tmp/wave21-export.aio.json", "dirty": false}},
  {"tool": "document_save", "args": {"path": "/tmp/wave21-export.html"}, "expect": {"ok": true, "path": "/tmp/wave21-export.aio.json", "dirty": false}},
