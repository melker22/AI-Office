[
  {"tool": "document_new", "args": {"title": "Wave16 CTL model", "force": true}},
  {"tool": "insert_at_caret", "args": {"id": "p1", "offset": 0, "text": "Paragraph direction test"}},
  {"tool": "apply_paragraph_format", "args": {"id": "p1", "dir": "rtl", "align": "start", "lang": "ar"}},
  {"tool": "document_get", "args": {}, "expect": {
    "document.body.0.dir": "rtl",
    "document.body.0.align": "start"
  }},
  {"tool": "duplicate_blocks", "args": {"id": "p1", "after_id": "p1"}},
  {"tool": "document_get", "args": {}, "expect": {
    "document.body.1.dir": "rtl",
    "document.body.1.align": "start"
  }},
  {"tool": "apply_paragraph_format", "args": {"id": "p1", "dir": "auto"}},
  {"tool": "document_get", "args": {}, "expect": {
    "document.body.0.align": "start"
  }},
  {"tool": "document_stats", "args": {}, "expect": {"paragraphs": {"$gte": 2}}},
  {"tool": "validate", "args": {}, "expect": {"valid": true}}
]
