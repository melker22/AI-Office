[
  {"tool": "document_new", "args": {"title": "Wave20 RTF roundtrip", "force": true}},
  {"tool": "set_vars", "args": {"vars": {"sender.name": "Ada", "status": "go"}}},
  {"tool": "insert_blocks", "args": {"after_id": "start", "blocks": [
    {"type": "heading", "level": 1, "runs": [{"text": "Titulo RTF"}]},
    {"type": "paragraph", "runs": [
      {"text": "Mix "},
      {"text": "bold", "bold": true},
      {"text": " and "},
      {"text": "italic", "italic": true},
      {"text": "."}
    ]},
    {"type": "paragraph", "dir": "rtl", "lang": "ar", "runs": [{"text": "rtl"}]},
    {"type": "list-item", "list_kind": "bullet", "level": 1, "runs": [{"text": "Um"}]},
    {"type": "list-item", "list_kind": "bullet", "level": 2, "runs": [{"text": "Dois"}]},
    {"id": "pNote", "type": "paragraph", "runs": [{"text": "Com nota."}]},
    {"id": "pField", "type": "paragraph", "runs": [{"text": ""}]},
    {"id": "pMark", "type": "paragraph", "runs": [{"text": "Marcador aqui."}]},
    {"id": "img1", "type": "image", "path": "qa/fixtures/wave19-dot.png", "width_mm": 8, "alt": "dot"}
  ]}},
  {"tool": "insert_table", "args": {"after_id": "end", "rows": 2, "cols": 2, "header": true, "header_texts": ["H1", "H2"], "cells": ["a", "b"]}},
  {"tool": "insert_footnote", "args": {"id": "pNote", "offset": 0, "text": "Nota RTF"}},
  {"tool": "insert_field", "args": {"id": "pField", "offset": 0, "kind": "sender", "arg": "name"}},
  {"tool": "bookmark_add", "args": {"id": "pMark", "name": "wave20bm"}},
  {"tool": "document_save", "args": {"path": "/tmp/wave20-rtf-roundtrip-criterion.rtf"}}
]
