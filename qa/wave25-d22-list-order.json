[
  {"tool": "document_new", "args": {"title": "Wave25 D22 order", "force": true}},
  {"tool": "apply_paragraph_format", "args": {"id": "p1", "lang": "pt-PT"}},
  {"tool": "insert_at_caret", "args": {"id": "p1", "text": "Before the list"}},
  {"tool": "insert_blocks", "args": {"after_id": "p1", "blocks": [
    {"type": "list-item", "level": 1, "list_kind": "bullet", "runs": [{"text": "Alpha"}]},
    {"type": "list-item", "level": 3, "list_kind": "bullet", "runs": [{"text": "Gamma"}]},
    {"type": "list-item", "level": 2, "list_kind": "bullet", "runs": [{"text": "Delta"}]}
  ]}},
  {"tool": "document_export_pdf", "args": {"path": "build/linux/wave25-d22-list-order.pdf", "pdfa": true, "ua": true}}
]
