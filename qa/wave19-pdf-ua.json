[
  {"tool": "document_new", "args": {"title": "Wave19 PDF/UA suite", "force": true}},
  {"tool": "document_set_title", "args": {"author": "Ada", "subject": "UA structure", "keywords": "ua,wave19"}},
  {"tool": "apply_paragraph_format", "args": {"id": "p1", "lang": "pt-PT"}},
  {"tool": "set_header", "args": {"text": "Wave19 header", "page_numbers": true}},
  {"tool": "set_footer", "args": {"text": "Wave19 footer"}},
  {"tool": "insert_blocks", "args": {"after_id": "p1", "blocks": [
    {"type": "heading", "level": 1, "runs": [{"text": "Capitulo"}]},
    {"id": "intro", "type": "paragraph", "runs": [
      {"text": "Intro em portugues com "},
      {"text": "English span", "lang": "en-US"},
      {"text": " no meio."}
    ]},
    {"type": "heading", "level": 2, "runs": [{"text": "Tabela e lista"}]},
    {"type": "paragraph", "runs": [{"text": "Antes da tabela."}]},
    {"type": "table", "header": true, "rows": 2, "cols": 2},
    {"type": "paragraph", "runs": [{"text": "Depois da tabela."}]},
    {"type": "list-item", "listKind": "bullet", "runs": [{"text": "Item um"}]},
    {"type": "list-item", "listKind": "bullet", "runs": [{"text": "Item dois"}]},
    {"id": "fig1", "type": "image", "path": "qa/fixtures/wave19-dot.png", "width_mm": 12, "alt": "Pixel decorativo vermelho"}
  ]}},
  {"tool": "insert_footnote", "args": {"id": "intro", "offset": 0, "text": "Nota de rodape wave19."}},
  {"tool": "toc_update", "args": {"min_level": 1, "max_level": 2}},
  {"tool": "document_export_pdf", "args": {"path": "/tmp/wave19-ua.pdf", "pdfa": true, "ua": true}}
]
