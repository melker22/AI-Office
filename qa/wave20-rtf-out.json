[
  {"tool": "document_new", "args": {"title": "Wave20 RTF out", "force": true}},
  {"tool": "insert_blocks", "args": {"after_id": "start", "blocks": [
    {"type": "heading", "level": 1, "lang": "pt-PT", "runs": [{"text": "Titulo RTF", "bold": true, "color": "#B5651D"}]},
    {"type": "paragraph", "lang": "pt-PT", "dir": "ltr", "runs": [
      {"text": "Ola "},
      {"text": "English", "lang": "en-US", "italic": true},
      {"text": " fim."}
    ]},
    {"type": "paragraph", "dir": "rtl", "lang": "ar-SA", "runs": [{"text": "مرحبا"}]}
  ]}},
  {"tool": "insert_list", "args": {"after_id": "end", "kind": "bullet", "items": ["Item um", "Item dois"]}},
  {"tool": "insert_table", "args": {"after_id": "end", "rows": 2, "cols": 2, "header": true, "header_texts": ["Nome", "Valor"], "cells": ["Alpha", "1"]}},
  {"tool": "insert_image", "args": {"after_id": "end", "path": "qa/fixtures/wave19-pixel.png", "width_mm": 15}},
  {"tool": "set_image", "args": {"id": "img1", "alt": "Pixel teste"}},
  {"tool": "insert_footnote", "args": {"id": "p2", "offset": 3, "text": "Nota wave20."}},
  {"tool": "insert_field", "args": {"id": "p2", "offset": 0, "kind": "page_number"}},
  {"tool": "bookmark_add", "args": {"id": "h1", "offset": 0, "name": "inicio"}},
  {"tool": "insert_break", "args": {"after_id": "end", "kind": "page"}},
  {"tool": "insert_blocks", "args": {"after_id": "end", "blocks": [
    {"type": "paragraph", "runs": [{"text": "Pagina dois."}]}
  ]}},
  {"tool": "document_save", "args": {"path": "/tmp/wave20-rtf-out.rtf"}, "expect": {"ok": true}},
  {"tool": "validate", "args": {}, "expect": {"valid": true}}
]
