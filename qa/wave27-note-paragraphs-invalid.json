  {"tool": "insert_footnote", "args": {"id": "p1", "offset": 0, "paragraphs": [], "text": "x"},
   "expect": {"ok": false, "error": "paragraphs must be a non-empty array of strings"}},
  {"tool": "insert_endnote", "args": {"id": "p1", "offset": 0, "paragraphs": ["ok", 3]},
