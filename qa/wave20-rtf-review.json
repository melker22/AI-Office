[
  {"tool": "document_new", "args": {"title": "RTF review", "force": true}},
  {"tool": "create_style", "args": {"name": "Normal", "font": "Arial"}},
  {"tool": "insert_at_caret", "args": {"id": "p1", "offset": 0, "text": "Antes"}},
  {"tool": "insert_blocks", "args": {"after_id": "p1", "blocks": [
    {"id": "pUni", "type": "paragraph", "runs": [{"text": "耀한😀"}]},
    {"id": "pLink", "type": "paragraph", "runs": [{"text": "site", "link": "https://example.com/wave20"}]},
    {"id": "imgJ", "type": "image", "width_mm": 30, "image_mime": "image/jpeg", "alt": "Foto jpeg",
     "image_b64": ""},
    {"id": "h1", "type": "heading", "level": 1, "runs": [{"text": "Titulo"}]},
    {"id": "t1", "type": "table", "rows": [[{"runs": [{"text": "Celula"}]}]]},
    {"id": "pDepois", "type": "paragraph", "runs": [{"text": "Depois"}]}
  ]}},
  {"tool": "document_save", "args": {"path": "/tmp/wave20-rtf-review.rtf"}, "expect": {"ok": true}}
]
